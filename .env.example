# Inquiso has NO runtime environment variables.
#
# The extension is serverless and local-first: AI provider API keys (Qwen/
# DashScope, OpenAI, Anthropic, Google, …) are entered in the extension UI
# (Settings → Models) and stored AES-GCM-encrypted in the background worker —
# never in env files, never in this repository.
#
# The only environment variables in this project belong to the demo-portal
# deployment script (deploy/alibaba/deploy.sh):

# Alibaba Cloud OSS bucket that hosts the demo portals (required by deploy.sh)
OSS_BUCKET=inquiso-demo

# OSS region id (optional; defaults to eu-central-1)
OSS_REGION=eu-central-1

# Alibaba Cloud credentials are configured via `ossutil config` (stored in
# your local ossutil profile), not via environment variables.
